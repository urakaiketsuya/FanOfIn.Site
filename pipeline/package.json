{
  "name": "@gatcg/pipeline",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "repl": "tsx src/repl.ts",
    "omnidex:build-index": "tsx src/omnidex/rebuildIndex.ts",
    "test": "tsx --test src/**/*.test.ts",
    "validate:archetypes": "tsx src/analysis/archetypeTaxonomyValidation.ts",
    "audit:diao": "tsx src/analysis/diaoModelAudit.ts",
    "audit:diao:migration": "tsx src/analysis/diaoMigrationAudit.ts",
    "audit:packages": "tsx src/analysis/packageCandidateAudit.ts",
    "clean:similarity-cache": "rm -rf .cache/similarity-cache",
    "tags:silvie": "GATCG_SILVIE_TAGS_ONLY=1 tsx src/index.ts",
    "api:publish": "tsx src/public-api/publish.ts",
    "audit:win-rate-packages": "node --import tsx src/analysis/winRatePackageAudit.ts",
    "archetypes:references": "node --import tsx scripts/rebuild-reference-archetypes.ts"
  },
  "dependencies": {
    "@gatcg/shared": "*",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2"
  }
}
